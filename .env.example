# Copia a .env y rellena. Nunca subas .env al repositorio.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Correo saliente (reclamaciones y envío de facturas)
SMTP_USUARIO=
SMTP_CLAVE=

# Buzón de entrada de facturas
IMAP_USUARIO=
IMAP_CLAVE=

# Google Drive (cuenta de servicio)
GOOGLE_APPLICATION_CREDENTIALS=

# Certificado electrónico para remitir a la AEAT
AEAT_CERT_PEM=
AEAT_KEY_PEM=
